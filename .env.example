# Port. v1 runs on 3001, so v2 defaults to 3002 and the two can run side by side.
PORT=3002

# Master key: unrestricted, may touch any session id. Rotate this.
API_KEY=change-this-shared-secret

# Per-client scoped keys: prefix:key, comma separated.
# A key may only touch sessions whose id starts with "<prefix>-".
# Clients that press تفعيل واتساب get theirs minted into provisioned-keys.json
# instead, so most deployments leave this empty.
SCOPED_API_KEYS=

# 'silent' (default), 'error', 'info', 'debug' - Baileys is very chatty above error.
BAILEYS_LOG_LEVEL=silent
